# ===========================================
# PocketClaw Python Backend — Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Service Ports ───────────────────────────
PORT=8764
LLM_PROXY_PORT=8765

# ── MySQL ───────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=openfriday

# ── Redis (optional, used for caching) ──────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Auth ────────────────────────────────────
JWT_SECRET=

# ── WeChat Mini Program ─────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=